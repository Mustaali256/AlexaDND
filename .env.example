# Copy this file to .env and fill in your details. Never commit the real .env file.

# Amazon domain for your region, e.g. amazon.com, amazon.co.uk, amazon.de
AMAZON_URL=amazon.com

AMAZON_EMAIL=you@example.com
AMAZON_PASSWORD=your-amazon-password

# Optional: base32 TOTP secret if your Amazon account uses an authenticator app
# for 2FA. Leave blank to be prompted for a security code during setup instead.
AMAZON_OTP_SECRET=

# The exact device name as it appears in the Alexa app (Devices > Echo & Alexa),
# e.g. "Bedroom Echo Dot"
ALEXA_DEVICE_NAME=Bedroom Echo Dot
